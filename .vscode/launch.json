{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Export Sprites",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/exportsprites.py",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}/scripts"
        },
        {
            "name": "Export Images",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/shimgx.py",
            "console": "integratedTerminal",
            "args": "-s ${workspaceFolder} -k ${config:sisterhood.ksreProjectDir} -r ${config:sisterhood.referenceDir} -w ${config:sisterhood.waifu2xDir} ${command:pickArgs}",
        },
        {
            "name": "Export Journal",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/journal.py",
            "console": "integratedTerminal",
            "args": "-d ${config:sisterhood.ksreProjectDir} ${command:pickArgs}",
            "cwd": "${workspaceFolder}/scripts"
        },
        {
            "name": "Build .rpa File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/build.py",
            "console": "integratedTerminal",
            "args": "-s ${workspaceFolder} -k ${config:sisterhood.ksreProjectDir} -b ${config:sisterhood.buildDir} ${command:pickArgs}",
        }
    ]
}
